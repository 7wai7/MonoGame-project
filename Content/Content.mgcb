
#----------------------------- Global Properties ----------------------------#

/outputDir:bin/$(Platform)
/intermediateDir:obj/$(Platform)
/platform:DesktopGL
/config:
/profile:HiDef
/compress:False

#-------------------------------- References --------------------------------#


#---------------------------------- Content ---------------------------------#

#begin Effects/TerrainMaterial.fx
/importer:EffectImporter
/processor:EffectProcessor
/build:Effects/TerrainMaterial.fx

# GPU control texture: R=grass, G=rock, B=unused, A=snow.
# The opaque RGB TerrainControl.png is retained for visual inspection.
#begin ../Assets/Terrains/Rugged Terrain with Rivers/Masks/TerrainControlGpu.png
/importer:TextureImporter
/processor:TextureProcessor
/processorParam:ColorKeyEnabled=False
/processorParam:GenerateMipmaps=True
/processorParam:PremultiplyAlpha=False
/processorParam:TextureFormat=Color
/build:../Assets/Terrains/Rugged Terrain with Rivers/Masks/TerrainControlGpu.png;TerrainMaterials/Control

# River coverage is a separate grayscale mask.
#begin ../Assets/Terrains/Rugged Terrain with Rivers/Masks/River.png
/importer:TextureImporter
/processor:TextureProcessor
/processorParam:ColorKeyEnabled=False
/processorParam:GenerateMipmaps=True
/processorParam:PremultiplyAlpha=False
/processorParam:TextureFormat=Color
/build:../Assets/Terrains/Rugged Terrain with Rivers/Masks/River.png;TerrainMaterials/River

# Grass RGB is albedo; alpha is material height for boundary blending.
#begin ../Assets/Textures/sparse_grass_2k.blend/textures/sparse_grass_albedo_height_2k.png
/importer:TextureImporter
/processor:TextureProcessor
/processorParam:ColorKeyEnabled=False
/processorParam:GenerateMipmaps=True
/processorParam:PremultiplyAlpha=False
/processorParam:TextureFormat=Color
/build:../Assets/Textures/sparse_grass_2k.blend/textures/sparse_grass_albedo_height_2k.png;TerrainMaterials/Grass

# Rock and snow also pack material height into albedo alpha.
#begin ../Assets/Textures/gray_rocks_2k.blend/textures/gray_rocks_albedo_height_2k.png
/importer:TextureImporter
/processor:TextureProcessor
/processorParam:ColorKeyEnabled=False
/processorParam:GenerateMipmaps=True
/processorParam:PremultiplyAlpha=False
/processorParam:TextureFormat=Color
/build:../Assets/Textures/gray_rocks_2k.blend/textures/gray_rocks_albedo_height_2k.png;TerrainMaterials/Rock

#begin ../Assets/Textures/Snow006_2K-PNG/Snow006_2K-PNG_AlbedoHeight.png
/importer:TextureImporter
/processor:TextureProcessor
/processorParam:ColorKeyEnabled=False
/processorParam:GenerateMipmaps=True
/processorParam:PremultiplyAlpha=False
/processorParam:TextureFormat=Color
/build:../Assets/Textures/Snow006_2K-PNG/Snow006_2K-PNG_AlbedoHeight.png;TerrainMaterials/Snow

# RGB stores a linear OpenGL normal; alpha stores linear roughness.
# Keep premultiplication disabled so transparent-looking roughness values do
# not modify the normal vector.
#begin ../Assets/Textures/sparse_grass_2k.blend/textures/sparse_grass_normal_rough_2k.png
/importer:TextureImporter
/processor:TextureProcessor
/processorParam:ColorKeyEnabled=False
/processorParam:GenerateMipmaps=True
/processorParam:PremultiplyAlpha=False
/processorParam:TextureFormat=Color
/build:../Assets/Textures/sparse_grass_2k.blend/textures/sparse_grass_normal_rough_2k.png;TerrainMaterials/GrassNormalRough

#begin ../Assets/Textures/gray_rocks_2k.blend/textures/gray_rocks_normal_rough_2k.png
/importer:TextureImporter
/processor:TextureProcessor
/processorParam:ColorKeyEnabled=False
/processorParam:GenerateMipmaps=True
/processorParam:PremultiplyAlpha=False
/processorParam:TextureFormat=Color
/build:../Assets/Textures/gray_rocks_2k.blend/textures/gray_rocks_normal_rough_2k.png;TerrainMaterials/RockNormalRough

#begin ../Assets/Textures/Snow006_2K-PNG/Snow006_2K-PNG_NormalRough.png
/importer:TextureImporter
/processor:TextureProcessor
/processorParam:ColorKeyEnabled=False
/processorParam:GenerateMipmaps=True
/processorParam:PremultiplyAlpha=False
/processorParam:TextureFormat=Color
/build:../Assets/Textures/Snow006_2K-PNG/Snow006_2K-PNG_NormalRough.png;TerrainMaterials/SnowNormalRough

# Material-local displacement shapes boundaries via albedo alpha; it does
# not move terrain vertices. The shader remaps each source brightness range.
