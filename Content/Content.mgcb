# Material-local displacement maps shape the transitions; they do not move
# terrain vertices. The shader remaps their different brightness ranges.
#begin ../Assets/Textures/sparse_grass_2k.blend/textures/sparse_grass_disp_2k.png
/importer:TextureImporter
/processor:TextureProcessor
/processorParam:ColorKeyEnabled=False
/processorParam:GenerateMipmaps=True
/processorParam:PremultiplyAlpha=False
/processorParam:TextureFormat=Color
/build:../Assets/Textures/sparse_grass_2k.blend/textures/sparse_grass_disp_2k.png;TerrainMaterials/GrassHeight

